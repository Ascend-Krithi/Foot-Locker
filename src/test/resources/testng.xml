        <listener class-name="com.fl.automation.listeners.TestListener"/>
    </listeners>
    <test name="Store Locator Tests">
        <classes>
            <class name="com.fl.automation.tests.TS001_TC001_LaunchHomepageVerifyFindStore"/>
